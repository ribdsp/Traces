{
  "name": "bugbait",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately broken checkout, used to produce the recordings Traces investigates.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings=0",
