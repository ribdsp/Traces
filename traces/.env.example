# Copy to `.env.local` and fill in. `.env.local` is gitignored — keep tokens out of the repo.

# WebMCP Origin Trial token, from the Chrome Early Preview Program.
# Bound to a single origin: the localhost token will not work on the Vercel URL, and vice versa.
# Left empty, the app falls back to the polyfill in src/lib/webmcp/polyfill.ts.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=
