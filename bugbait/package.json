    "test": "vitest run",
    "test:watch": "vitest",
    "record:fixtures": "node scripts/record-fixtures.mjs"
  },
  "dependencies": {
    "@rrweb/rrweb-plugin-console-record": "^2.0.0-alpha.18",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rrweb": "2.0.0-alpha.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
